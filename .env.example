# XELYON CLI Environment Variables
# Copy this file to .env and fill in your API keys

# ========================================
# LLM Provider Selection
# ========================================
# Specify which LLM provider to use by default
# Options: deepseek, openai, gemini, claude, ollama, groq
# XELYON_PROVIDER=deepseek

# ========================================
# API Keys (Provider-specific)
# ========================================

# DeepSeek API Key
# Get your key at: https://platform.deepseek.com/
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI API Key
# Get your key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key
# Get your key at: https://makersuite.google.com/app/apikey
# GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic (Claude) API Key
# Get your key at: https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Groq API Key
# Get your key at: https://console.groq.com/
# GROQ_API_KEY=your_groq_api_key_here

# ========================================
# Ollama Configuration (Local LLM)
# ========================================
# Base URL for Ollama server (default: http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434

# ========================================
# Optional: RAG Search (XELYON Cloud)
# ========================================
# User ID for RAG search feature
# XELYON_USER_ID=your_user_id_here

# ========================================
# Optional: Web Search (Serper)
# ========================================
# Serper API Key for web search tool
# Get your key at: https://serper.dev/
# SERPER_API_KEY=your_serper_api_key_here
